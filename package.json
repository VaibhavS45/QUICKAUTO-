{
  "name": "palette",
  "version": "0.1.0",
  "description": "Palette — desktop assistant shell with automation routines",
  "type": "module",
  "author": "",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "node scripts/build-preload.mjs && electron-vite dev",
    "build": "electron-vite build && node scripts/build-preload.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.74",
    "@ai-sdk/openai": "^4.0.86",
